<Window x:Class="MinimalFences.Views.ImageCropWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:MinimalFences.Services"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
 Width="380" Height="490" ShowInTaskbar="False">
 <Window.Resources>
  <Style x:Key="HeaderCloseButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="{DynamicResource Muted}" />
   <Setter Property="Width" Value="28" />
   <Setter Property="Height" Value="28" />
   <Setter Property="Focusable" Value="False" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="6">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Brd" Property="Background" Value="#30FF5376" />
        <Setter Property="Foreground" Value="#FF5376" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
   BorderThickness="1.5" CornerRadius="16" Margin="10"
   MouseLeftButtonDown="WindowMouseDown">
  <Border.Effect>
   <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.65" Color="#000000" />
  </Border.Effect>
  <Grid Margin="18">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,12">
    <Button DockPanel.Dock="Right" Style="{StaticResource HeaderCloseButton}" Click="CancelClick">
     <Path Data="M 0,0 L 8,8 M 0,8 L 8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Button>
    <TextBlock Text="{Binding CropImageTitle, Source={x:Static services:AppLocalization.Current}}"
      FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Foreground}" VerticalAlignment="Center" />
   </DockPanel>
   <Border Grid.Row="1" Width="240" Height="240" Background="#10131A" BorderBrush="{DynamicResource Border}"
     BorderThickness="1.5" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center"
     MouseLeftButtonDown="ViewportMouseDown" MouseMove="ViewportMouseMove" MouseLeftButtonUp="ViewportMouseUp"
     MouseWheel="ViewportMouseWheel" Cursor="SizeAll">
    <Grid x:Name="CropContainer" Width="240" Height="240">
     <Canvas x:Name="ImageCanvas" Width="240" Height="240" IsHitTestVisible="False">
      <Image x:Name="SourceImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
     </Canvas>
     <Path Fill="#A0090C12" IsHitTestVisible="False">
      <Path.Data>
       <CombinedGeometry GeometryCombineMode="Exclude">
        <CombinedGeometry.Geometry1>
         <RectangleGeometry Rect="0,0,240,240" />
        </CombinedGeometry.Geometry1>
        <CombinedGeometry.Geometry2>
         <RectangleGeometry Rect="30,30,180,180" RadiusX="14" RadiusY="14" />
        </CombinedGeometry.Geometry2>
       </CombinedGeometry>
      </Path.Data>
     </Path>
     <Rectangle Width="180" Height="180" RadiusX="14" RadiusY="14"
       Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="3 2"
       IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
   </Border>
   <TextBlock Grid.Row="2" Text="{Binding CropImagePanHint, Source={x:Static services:AppLocalization.Current}}"
     FontSize="11" Foreground="{DynamicResource Muted}" TextAlignment="Center" Margin="0,8,0,8" />
   <Grid Grid.Row="3" Margin="10,0,10,14">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
     <DockPanel Margin="0,0,0,2">
      <TextBlock Text="{Binding CropImageZoom, Source={x:Static services:AppLocalization.Current}}"
        FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
      <TextBlock x:Name="ZoomText" Text="100%" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Foreground}" />
     </DockPanel>
     <Slider x:Name="ZoomSlider" Minimum="0.1" Maximum="5.0" Value="1.0" ValueChanged="ZoomSliderChanged" />
    </StackPanel>
    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" BorderBrush="{DynamicResource Accent}"
      BorderThickness="1.5" ClipToBounds="True" Background="#151820" VerticalAlignment="Center">
     <Image x:Name="LivePreviewImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
    </Border>
   </Grid>
   <DockPanel Grid.Row="4" LastChildFill="False">
    <Button Content="{Binding ColorCancel, Source={x:Static services:AppLocalization.Current}}"
      DockPanel.Dock="Right" Padding="18,8" Margin="0" Click="CancelClick" />
    <Button Content="{Binding ColorApply, Source={x:Static services:AppLocalization.Current}}"
      DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="20,8" Margin="0,0,10,0"
      Click="ApplyClick" />
   </DockPanel>
  </Grid>
 </Border>
</Window>
