<Window x:Class="MinimalFences.Views.GroupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:MinimalFences.Services"
 WindowStyle="None" AllowsTransparency="True" Background="#01000000"
 ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
 WindowStartupLocation="Manual"
 AllowDrop="True"
 PreviewDragEnter="OnDragEnter" DragEnter="OnDragEnter"
 PreviewDragOver="OnDragOver" DragOver="OnDragOver"
 Drop="OnDrop">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis" />

  <Style x:Key="Grip" TargetType="Thumb">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border Background="{TemplateBinding Background}" />
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="HeaderButtonStyle" TargetType="Button">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="{Binding IconTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
   <Setter Property="Focusable" Value="False" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Brd" Background="#18C6D0E2" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Brd" Property="Background" Value="#30C6D0E2" />
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Brd" Property="Background" Value="#45C6D0E2" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <DataTemplate x:Key="GridItemTemplate">
   <Border Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
     Padding="4" Margin="2" CornerRadius="10" ToolTip="{Binding Tooltip}"
     BorderThickness="1" BorderBrush="Transparent"
     MouseLeftButtonDown="ItemDown" MouseMove="ItemMove" MouseLeftButtonUp="ItemUp" MouseRightButtonUp="ItemMenu"
     Focusable="True" KeyDown="ItemKeyDown" AutomationProperties.Name="{Binding Label}">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#252A36" />
        <Setter Property="BorderBrush" Value="#6000E5D4" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="Background" Value="#352A36" />
        <Setter Property="BorderBrush" Value="#9000E5D4" />
       </Trigger>
       <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Background" Value="#3800E5D4" />
        <Setter Property="BorderBrush" Value="#B000E5D4" />
       </DataTrigger>
       <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
         <Condition Binding="{Binding IsSelected}" Value="True" />
         <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#4D00E5D4" />
        <Setter Property="BorderBrush" Value="#D000E5D4" />
       </MultiDataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <StackPanel HorizontalAlignment="Center">
     <Image Source="{Binding Icon}" Width="{Binding IconPixels, RelativeSource={RelativeSource AncestorType=Window}}"
       Height="{Binding IconPixels, RelativeSource={RelativeSource AncestorType=Window}}" RenderOptions.BitmapScalingMode="HighQuality" />
     <TextBlock Text="{Binding Label}" Foreground="{Binding IconTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
        FontFamily="{Binding ItemFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
        TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" Height="34" Margin="0,6,0,0"
        Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
   </Border>
  </DataTemplate>

  <DataTemplate x:Key="ListItemTemplate">
   <Border HorizontalAlignment="Stretch"
     Padding="8,5" Margin="2,1" CornerRadius="8" ToolTip="{Binding Tooltip}"
     BorderThickness="1" BorderBrush="Transparent"
     MouseLeftButtonDown="ItemDown" MouseMove="ItemMove" MouseLeftButtonUp="ItemUp" MouseRightButtonUp="ItemMenu"
     Focusable="True" KeyDown="ItemKeyDown" AutomationProperties.Name="{Binding Label}">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#252A36" />
        <Setter Property="BorderBrush" Value="#6000E5D4" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="Background" Value="#352A36" />
        <Setter Property="BorderBrush" Value="#9000E5D4" />
       </Trigger>
       <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Background" Value="#3800E5D4" />
        <Setter Property="BorderBrush" Value="#B000E5D4" />
       </DataTrigger>
       <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
         <Condition Binding="{Binding IsSelected}" Value="True" />
         <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="#4D00E5D4" />
        <Setter Property="BorderBrush" Value="#D000E5D4" />
       </MultiDataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <DockPanel LastChildFill="True">
     <Image Source="{Binding Icon}" Width="24" Height="24" Margin="2,0,10,0" VerticalAlignment="Center"
       RenderOptions.BitmapScalingMode="HighQuality" />
     <TextBlock Text="{Binding Label}" Foreground="{Binding IconTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
        FontFamily="{Binding ItemFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
        VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"
        Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </DockPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Border x:Name="Frame" Padding="2" CornerRadius="16" BorderThickness="1.5" ClipToBounds="True"
   AllowDrop="True" PreviewDragEnter="OnDragEnter" DragEnter="OnDragEnter" PreviewDragOver="OnDragOver" DragOver="OnDragOver" Drop="OnDrop">
  <Grid AllowDrop="True" PreviewDragEnter="OnDragEnter" DragEnter="OnDragEnter" PreviewDragOver="OnDragOver" DragOver="OnDragOver" Drop="OnDrop">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
   <Border x:Name="Header" MinHeight="36" Background="Transparent" Padding="8,8,8,6"
      AllowDrop="True" PreviewDragEnter="OnDragEnter" DragEnter="OnDragEnter" PreviewDragOver="OnDragOver" DragOver="OnDragOver" Drop="OnDrop"
      MouseLeftButtonDown="HeaderDown" MouseMove="HeaderMove" MouseLeftButtonUp="HeaderUp">
    <Grid>
     <DockPanel x:Name="HorizontalHeader" LastChildFill="True">
       <Button DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Margin="0"
         ToolTip="{Binding GroupOptionsTooltip, Source={x:Static services:AppLocalization.Current}}"
         Click="GroupOptions" AutomationProperties.Name="Group options"
         Style="{StaticResource HeaderButtonStyle}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
         <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
         <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
        </StackPanel>
       </Button>
       <Button x:Name="RollUpButtonH" DockPanel.Dock="Right" Width="24" Height="24" Padding="0" Margin="0,0,4,0"
         ToolTip="{Binding RollUpTooltip, RelativeSource={RelativeSource AncestorType=Window}}"
         Click="ToggleRollUpClick" AutomationProperties.Name="Roll up or expand"
         Style="{StaticResource HeaderButtonStyle}">
        <Path x:Name="RollUpArrowH" Data="M 0,4 L 4,0 L 8,4"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
       </Button>
      <StackPanel x:Name="HorizontalTitleRow" Orientation="Horizontal" VerticalAlignment="Center">
       <Grid x:Name="BadgeContainerH" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
       <TextBlock x:Name="TitleTextH" Text="{Binding Model.Name}" FontWeight="Bold" FontSize="13"
         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
     </DockPanel>

     <StackPanel x:Name="VerticalHeader" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,6,0,6">
       <Button x:Name="RollUpButtonV" Width="28" Height="28" Margin="0,0,0,4" Padding="0"
         ToolTip="{Binding RollUpTooltip, RelativeSource={RelativeSource AncestorType=Window}}"
         Click="ToggleRollUpClick" AutomationProperties.Name="Roll up or expand"
         Style="{StaticResource HeaderButtonStyle}">
        <Path x:Name="RollUpArrowV" Data="M 0,0 L 4,4 L 0,8"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
       </Button>
       <Button Width="28" Height="24" Margin="0,0,0,8" Padding="0"
         ToolTip="{Binding GroupOptionsTooltip, Source={x:Static services:AppLocalization.Current}}"
         Click="GroupOptions" AutomationProperties.Name="Group options"
         Style="{StaticResource HeaderButtonStyle}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
         <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
         <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1.5,0" />
        </StackPanel>
       </Button>
      <Grid x:Name="BadgeContainerV" Width="16" Height="16" Margin="0,0,0,8" HorizontalAlignment="Center" />
      <TextBlock x:Name="TitleTextV" FontWeight="Bold"
        VerticalAlignment="Top" HorizontalAlignment="Center"
        TextAlignment="Center" TextWrapping="NoWrap" LineStackingStrategy="BlockLineHeight" />
     </StackPanel>
    </Grid>
   </Border>
   <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="6,0,6,8"
     Background="Transparent" AllowDrop="True" PreviewDragEnter="OnDragEnter" DragEnter="OnDragEnter" PreviewDragOver="OnDragOver" DragOver="OnDragOver" Drop="OnDrop"
     PreviewMouseWheel="OnContentScrollViewerPreviewMouseWheel">
    <Grid x:Name="ContentGrid" Background="Transparent" AllowDrop="True"
      MinHeight="{Binding ViewportHeight, ElementName=ContentScrollViewer}"
      MinWidth="{Binding ViewportWidth, ElementName=ContentScrollViewer}"
      PreviewDragEnter="OnDragEnter" DragEnter="OnDragEnter" PreviewDragOver="OnDragOver" DragOver="OnDragOver" Drop="OnDrop"
      MouseLeftButtonDown="ContentGrid_MouseLeftButtonDown"
      MouseMove="ContentGrid_MouseMove"
      MouseLeftButtonUp="ContentGrid_MouseLeftButtonUp">
     <Border x:Name="EmptyHint" Visibility="Collapsed" Margin="16" Padding="16"
       Background="#201C2028" CornerRadius="12" BorderBrush="#35303648" BorderThickness="1"
       VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock Text="{Binding EmptyHint, Source={x:Static services:AppLocalization.Current}}"
        Foreground="#8A9BBF" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" />
     </Border>
     <ItemsControl x:Name="IconGrid" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GridItemTemplate}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
     <Border x:Name="SelectionBox" Visibility="Collapsed"
       Background="#3300E5D4" BorderBrush="#9900E5D4" BorderThickness="1" CornerRadius="2"
       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>
   </ScrollViewer>
   <Thumb Style="{StaticResource Grip}" Tag="L" Width="6" HorizontalAlignment="Left" Grid.RowSpan="2" Cursor="SizeWE" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb Style="{StaticResource Grip}" Tag="R" Width="6" HorizontalAlignment="Right" Grid.RowSpan="2" Cursor="SizeWE" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb Style="{StaticResource Grip}" Tag="T" Height="6" VerticalAlignment="Top" Grid.RowSpan="2" Cursor="SizeNS" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb x:Name="GripB" Style="{StaticResource Grip}" Tag="B" Height="6" VerticalAlignment="Bottom" Grid.RowSpan="2" Cursor="SizeNS" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb Style="{StaticResource Grip}" Tag="TL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="2" Cursor="SizeNWSE" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb Style="{StaticResource Grip}" Tag="TR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.RowSpan="2" Cursor="SizeNESW" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb x:Name="GripBL" Style="{StaticResource Grip}" Tag="BL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.RowSpan="2" Cursor="SizeNESW" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
   <Thumb x:Name="GripBR" Style="{StaticResource Grip}" Tag="BR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.RowSpan="2" Cursor="SizeNWSE" DragStarted="ResizeStart" DragDelta="ResizeDelta" DragCompleted="ResizeEnd" />
  </Grid>
 </Border>
</Window>
